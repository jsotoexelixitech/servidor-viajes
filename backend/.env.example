# ─── Exelixi API — Variables de entorno ───────────────────────────────────────
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio (ya está en .gitignore).
#
# Forma rapida de generar secretos seguros:
#   node -e "process.stdout.write(require('crypto').randomBytes(40).toString('hex'))"
# ──────────────────────────────────────────────────────────────────────────────

# ── Aplicacion ─────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | staging
PORT=3000
APP_PREFIX=api
# En produccion agrega la URL publica de tu frontend separada por coma:
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ── Seguridad (OBLIGATORIO en produccion) ──────────────────────────────────────
#
# SESSION_SECRET: firma HMAC de los tokens de sesion de los clientes.
# Genera uno con: node -e "process.stdout.write(require('crypto').randomBytes(40).toString('hex'))"
SESSION_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_GENERADO_ALEATORIAMENTE

# SESSION_TTL_HOURS: tiempo de vida del token de sesion (horas)
SESSION_TTL_HOURS=8

# ADMIN_SECRET: protege las rutas POST/GET /api/admin/tenants.
# El operador usa este valor en el campo "Admin Key" del panel web para crear clientes.
# Genera uno con: node -e "process.stdout.write(require('crypto').randomBytes(40).toString('hex'))"
ADMIN_SECRET=CAMBIA_ESTO_POR_OTRO_SECRETO_ADMIN_DIFERENTE

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=exelixi
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=exelixi_api_db
DB_POOL_SIZE=50
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=10000

# ── Redis (colas, reintentos de polizas, circuit breaker, cache) ───────────────
# Windows portable: https://github.com/tporadowski/redis/releases
# Docker:           docker run -d -p 6379:6379 redis:7-alpine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Webhook externo ─────────────────────────────────────────────────────────────
# URL de tu plataforma donde se notifican los datos de cada viaje (opcional).
# Si se configura, cada viaje exitoso enviara un POST con los datos firmados con HMAC.
EXTERNAL_WEBHOOK_URL=
EXTERNAL_WEBHOOK_SECRET=
EXTERNAL_WEBHOOK_TIMEOUT=10000
EXTERNAL_WEBHOOK_RETRIES=3

# ── Rate limiting ───────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100000

# ── Logs ────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

# ── Cola de trabajos BullMQ ─────────────────────────────────────────────────────
QUEUE_CONCURRENCY=10
QUEUE_MAX_JOBS=10000


# ── Flota por uso (Ridery) ──────────────────────────────────────────────
# Crear tablas automáticamente (no hay migraciones). true en 120/121.
DB_SYNCHRONIZE=true
# Esquema propio si se usa una BD compartida (crearlo antes: CREATE SCHEMA flota;)
DB_SCHEMA=
# Póliza de flota y plan por defecto (se editan desde la pantalla)
FLOTA_CNPOLIZA_DEFAULT=18-1-1130480881
FLOTA_CPLAN_DEFAULT=LARA
# Recibo real en Sis2000 vía nest-api (POST /api/endosos/recibos). 0 = solo simulado.
FLOTA_RECIBO_REAL=0
NEST_API_URL=http://127.0.0.1:3002
NEST_API_KEY=

# true solo detrás de una URL con certificado (activa HSTS, COOP y upgrade-insecure-requests)
PUBLIC_HTTPS=false

# SSO desde Nexus (mismo patrón que los módulos RCV)
# Mismo secreto que nexus-api (TENANT_TOKEN_SECRET). Sin él, /auth/nexus responde 401.
TENANT_TOKEN_SECRET=
# nexus-api para el heartbeat (empresa/módulo activos). Vacío = no se consulta.
NEXUS_API_URL=http://127.0.0.1:3092
# Ids de submódulo Nexus aceptados (coma). Vacío = cualquiera.
NEXUS_EXPECTED_SUBMODULO_IDS=
# Empresa Nexus → flota: "empresaId:nombreFlota,..."; si no, FLOTA_NEXUS_TENANT_DEFAULT; si no, la única flota activa.
FLOTA_NEXUS_TENANT_MAP=
FLOTA_NEXUS_TENANT_DEFAULT=Ridery

# Pantalla por despliegue (marca y acceso). Por flota se puede sobrescribir con PUT /api/admin/tenants/:id/ui.
# UI_AUTH_MODES: nexus (entra solo desde Nexus) y/o apikey (campo de API key, uso interno u otras conexiones).
UI_AUTH_MODES=nexus,apikey
UI_BRAND_NAME=La Mundial
UI_BRAND_SUFFIX=de Seguros
UI_APP_TITLE=Flota por uso
UI_LOGO_URL=/brand/mundial-isotipo.png
UI_COLOR_PRIMARY=#0F1A5A
UI_COLOR_PRIMARY_DEEP=#091133
UI_COLOR_PRIMARY_BRIGHT=#162A7F
UI_COLOR_BLUE=#2E6DBF
UI_COLOR_ACCENT=#E84F51
UI_COLOR_ACCENT_CTA=#D4403F
UI_COLOR_ACCENT_HOVER=#BF3534
