# ─── Exelixi API — Variables de entorno ──────────────────────────────────────
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.

# Aplicación
NODE_ENV=development          # development | production | staging
PORT=3000
APP_PREFIX=api
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=exelixi
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=exelixi_api_db
DB_POOL_SIZE=50
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=10000

# Redis (colas de trabajo, circuit breaker, caché de tenants)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Webhook externo (destino donde se notifican los datos del viaje)
EXTERNAL_WEBHOOK_URL=https://tu-plataforma.com/webhook/viajes
EXTERNAL_WEBHOOK_SECRET=tu_secret_hmac
EXTERNAL_WEBHOOK_TIMEOUT=10000
EXTERNAL_WEBHOOK_RETRIES=3

# Seguridad — sesiones y admin
# SESSION_SECRET: genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia_esto_por_un_secreto_aleatorio_largo
SESSION_TTL_HOURS=8
# ADMIN_SECRET: protege las rutas /admin/tenants — obligatorio en producción
ADMIN_SECRET=cambia_esto_por_otro_secreto_admin

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100000

# Logs
LOG_LEVEL=info
LOG_DIR=logs

# Cola de trabajos BullMQ
QUEUE_CONCURRENCY=10
QUEUE_MAX_JOBS=10000
